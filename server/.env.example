# ========================================
# ResuAI Server — Environment Variables
# ========================================

# Server
PORT=5001
NODE_ENV=development

# MongoDB (replace with your MongoDB Atlas URI or local URI)
MONGO_URI=mongodb://localhost:27017/resuai

# JWT Secret (use a long random string in production)
JWT_SECRET=your_jwt_secret_key_change_this_in_production

# Gemini API Key (get from Google AI Studio)
GEMINI_API_KEY=
# Optional: Gemini model name
GEMINI_MODEL=gemini-1.5-flash

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# ========================================
# SMTP (required for real OTP emails)
# ========================================
# Mailtrap example:
# SMTP_HOST=sandbox.smtp.mailtrap.io
# SMTP_PORT=2525
# SMTP_USER=your_mailtrap_username
# SMTP_PASS=your_mailtrap_password
# SMTP_FROM="ResuAI <no-reply@resuai.local>"
#
# Gmail example (App Password required):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=yourgmail@gmail.com
# SMTP_PASS=your_16_char_app_password
# SMTP_FROM="ResuAI <yourgmail@gmail.com>"

SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_SECURE=false

# In development only: if SMTP is missing, prints OTP in server logs.
# Set to false when you want to strictly require SMTP.
ALLOW_DEV_OTP_FALLBACK=true
