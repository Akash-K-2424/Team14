# Used only when you run: npm run build
# Copy to .env.production and fill in before building on the server.

# Google Sign-In — add this exact origin in Google Cloud Console:
# APIs & Services → Credentials → OAuth client → Authorized JavaScript origins
# e.g. http://YOUR_EC2_PUBLIC_DNS  or  https://yourdomain.com
VITE_GOOGLE_CLIENT_ID=

# Only if the API is hosted on a different domain than the SPA:
# VITE_API_BASE_URL=https://api.yourdomain.com/api
